{
  "name": "@backoffice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "check:migrations": "node scripts/check-migrations-immutable.ts",
    "user:create": "node --env-file-if-exists=../../.env scripts/create-user.ts",
    "user:reset-password": "node --env-file-if-exists=../../.env scripts/reset-password.ts",
    "user:revoke-sessions": "node --env-file-if-exists=../../.env scripts/revoke-sessions.ts",
    "user:disable": "node --env-file-if-exists=../../.env scripts/disable-user.ts",
    "build:common-passwords": "node scripts/build-common-passwords.ts"
  },
  "dependencies": {
    "@backoffice/shared": "workspace:*",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}

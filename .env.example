# Copia este archivo como .env y rellena los valores. .env está en .gitignore: nunca lo subas.
# Ningún valor real (dominios, contraseñas) debe escribirse en este archivo de ejemplo.

# Entorno de ejecución: development | test | production
NODE_ENV=development
# Interfaz en la que escucha la API. 127.0.0.1 (por defecto) = solo este equipo: en desarrollo no es
# accesible desde la red local por HTTP. En el contenedor de la fase 2 se fijará de forma explícita.
HOST=127.0.0.1
# Puerto HTTP de la API
PORT=3000
# Origen público de la web: esquema + host + puerto, sin ruta ni barra final. En desarrollo, el del
# servidor de Vite. Las peticiones que modifican datos deben traer este Origin (protección CSRF).
# En producción debe ser https y nunca se escribe en el código.
PUBLIC_ORIGIN=http://localhost:5173
# Número de proxies inversos de confianza delante de la API. 0 (por defecto) = ninguno: la IP de cada
# petición es la de la conexión. Ponlo a 1 solo detrás de un proxy propio (docs/seguridad/limites.md).
TRUST_PROXY_HOPS=0
# Clave de cifrado de las semillas TOTP: 32 bytes aleatorios en base64. Genérala con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Si la pierdes o la cambias, hay que volver a dar de alta el TOTP (ver el README del módulo auth).
TOTP_ENCRYPTION_KEY=
# Versión de la clave anterior; súbela en 1 cada vez que la rotes.
TOTP_ENCRYPTION_KEY_VERSION=1
# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Credenciales del PostgreSQL local de compose.yaml (elige una contraseña larga y aleatoria)
POSTGRES_USER=backoffice
POSTGRES_PASSWORD=
POSTGRES_DB=backoffice
# Puerto del host en el que compose.yaml publica PostgreSQL (solo en 127.0.0.1). Cámbialo si el 5432
# está ocupado, p. ej. por un PostgreSQL nativo en Windows (ver README, sección Windows). Si lo cambias,
# usa el MISMO puerto en DATABASE_URL y TEST_DATABASE_URL.
POSTGRES_PORT=5432
# Cadena de conexión de PostgreSQL: postgres://usuario:contraseña@127.0.0.1:<POSTGRES_PORT>/base
DATABASE_URL=
# Base de datos para los tests de integración, en el mismo servidor y puerto (los tests crean y
# borran bases temporales en él): postgres://usuario:contraseña@127.0.0.1:<POSTGRES_PORT>/base
TEST_DATABASE_URL=
